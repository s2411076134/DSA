#include <stdio.h>
#include <stdlib.h>
#define MAX 4

int stack_arr[MAX];
int top = -1;

void push(int data){
    if(top==MAX-1){
        printf("stack overflow\n");
        return;
    }
    top++;
    stack_arr[top]=data;
    printf("%d pushed to stack\n",data);
    
}

int main(){
    push(10);
    push(20);
    push(30);
    push(40);
    push(50);
    return 0;
}
